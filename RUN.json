{
  "runcontract": 1,
  "services": [
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [["${python}", "-m", "pip", "install", "-q", "-r", "requirements.txt"]],
      "start": ["${python}", "-m", "uvicorn", "app.main:app", "--port", "${PORT}"],
      "port": 8000,
      "port_env": "PORT",
      "health": { "path": "/health", "expect_status": [200] },
      "env": {
        "JOB_DB_PATH": { "dev": "jobs.db" },
        "FRONTEND_ORIGIN": { "dev": "http://localhost:5173" }
      }
    }
  ]
}
